{
    "compilerOptions": {
        "types": ["node", "jest", "express"],
        "target": "ES2020",
        "module": "NodeNext",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "tests"]
}